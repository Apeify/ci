# Pinned actionlint release, shared by CI and the dev container.
#
# Sourced by BOTH .github/workflows/validate.yml and .devcontainer/setup.sh, so
# there is exactly one place to bump and no way for the two to disagree about
# which version they are checking against. A version and a checksum that drift
# apart is the failure this file exists to prevent.
#
# The checksum is the real pin. A version tag is mutable: if a release were
# re-cut under the same tag, the tag would still resolve and the download would
# silently change. Verifying against these hashes turns that into a hard failure
# instead.
#
# TO UPDATE
#   1. Pick the new version from https://github.com/rhysd/actionlint/releases
#   2. Take the matching lines from that release's checksums.txt:
#      https://github.com/rhysd/actionlint/releases/download/v<VERSION>/actionlint_<VERSION>_checksums.txt
#   3. Update all three values below together.
#
# Both architectures are listed because CI runs on linux/amd64 while a dev
# container on Apple Silicon runs linux/arm64.

ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_LINUX_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_SHA256_LINUX_ARM64=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
